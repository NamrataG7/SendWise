<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warning_overlay_background"
    android:clickable="true"
    android:focusable="true">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:background="@color/warning_card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Warning Icon -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_warning"
                android:contentDescription="Warning"
                android:tint="@color/accent" />

            <!-- Warning Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/warning_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/warning_text"
                android:gravity="center"
                android:fontFamily="sans-serif-medium" />

            <!-- Warning Message -->
            <TextView
                android:id="@+id/warning_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/warning_message"
                android:textSize="16sp"
                android:textColor="@color/warning_text"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3" />

            <!-- Category Badge (optional, can show detected category) -->
            <TextView
                android:id="@+id/category_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/badge_background"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:visibility="gone" />

            <!-- Legal Notice Section -->
            <LinearLayout
                android:id="@+id/legal_notice_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="@drawable/legal_notice_background"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚖️ Legal Notice"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/legal_text"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/legal_notice_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/legal_notice_default"
                    android:textSize="12sp"
                    android:textColor="@color/legal_text_secondary"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2" />

                <!-- Legal Disclaimer -->
                <TextView
                    android:id="@+id/legal_disclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingTop="8dp"
                    android:text="@string/legal_disclaimer"
                    android:textSize="10sp"
                    android:textStyle="italic"
                    android:textColor="@color/legal_text_secondary"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:background="@drawable/legal_notice_background" />

            </LinearLayout>

            <!-- Button Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Edit Button -->
                <Button
                    android:id="@+id/button_edit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/button_edit"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/button_edit"
                    android:paddingVertical="12dp"
                    style="@style/Widget.MaterialComponents.Button" />

                <!-- Send Anyway Button -->
                <Button
                    android:id="@+id/button_send_anyway"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/button_send_anyway"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/button_send_anyway"
                    android:paddingVertical="12dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
