# Local dev: point to a local Redis instance (docker run -p 6379:6379 redis:7).
# If unset, the app falls back to an in-memory stub (data lost on reload).
REDIS_URL=redis://localhost:6379

# Production (Vercel): use Vercel KV or Upstash Redis.
# Set REDIS_URL to the connection string from the Vercel KV / Upstash dashboard,
# e.g. rediss://default:<token>@<host>:<port>

# ---------------------------------------------------------------------------
# NextAuth (parent-account authentication)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
PARENT_EMAIL=parent@example.com
PARENT_PASSWORD_HASH=$2a$10$... # bcrypt hash, generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"

# ---------------------------------------------------------------------------
# Dev / demo seeder (POST /api/dev/seed) — see parental-dashboard/scripts/README.md
# ---------------------------------------------------------------------------
# Required by the endpoint via the `x-seed-token` request header.
SEED_TOKEN=changeme-dev-seed-token
# Belt-and-suspenders: in production the seeder returns 404 unless this is 'true'.
# Leave unset for real production launches; set to 'true' only when you need to
# pre-populate a Vercel demo deploy for Fig 3 screenshots.
# ALLOW_SEED=true
