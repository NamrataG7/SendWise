# ---------------------------------------------------------------------------
# Redis / KV store — persists ingest events, rate-limit counters, session data.
# ---------------------------------------------------------------------------

# Redis connection string. Local dev: `docker run -p 6379:6379 redis:7`. Prod:
# use the connection URL from Vercel KV / Upstash (rediss://default:<token>@…).
# If unset, the app falls back to an in-memory stub (data lost on reload).
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# NextAuth — parent-account authentication
# ---------------------------------------------------------------------------

# Signs NextAuth session JWTs. Generate with: `openssl rand -base64 32`.
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-base64-32

# Canonical URL NextAuth uses for callbacks. Localhost in dev, your Vercel URL in prod.
NEXTAUTH_URL=http://localhost:3000

# E-mail address of the single parent account allowed to sign in.
PARENT_EMAIL=parent@example.com

# bcrypt hash of the parent password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
PARENT_PASSWORD_HASH=$2a$10$...

# ---------------------------------------------------------------------------
# Dev / demo seeder — POST /api/dev/seed (see parental-dashboard/scripts/README.md)
# ---------------------------------------------------------------------------

# Shared secret required in the `x-seed-token` header. Generate any random string
# (e.g. `openssl rand -hex 24`). Never reuse in production.
SEED_TOKEN=changeme-dev-seed-token

# Belt-and-suspenders kill-switch: in production the seeder returns 404 unless
# this is exactly `true`. Leave unset for real launches; set to `true` only when
# pre-populating a Vercel demo deploy for Fig 3 screenshots.
# ALLOW_SEED=true
